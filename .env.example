# Public iCal address for Kristen's "Where I'll be" Google Calendar.
#
# Google Calendar → Settings for my calendars → <calendar> → Integrate
# calendar → "Public address in iCal format". The calendar needs Access
# permissions → "Make available to public" ticked, or the URL 404s.
#
# Accepts either the webcal:// or https:// form — the fetcher normalises it.
# Leave empty during local development to use the seed events instead.
PUBLIC_CALENDAR_ICS_URL=https://calendar.google.com/calendar/ical/a9c43a7a21e0a15400cbff307bc40013b6816ca29c7433b6c454b512bfdf7538%40group.calendar.google.com/public/basic.ics

# Used for canonical + Open Graph URLs.
PUBLIC_SITE_URL=http://localhost:4321

---
import { site } from "../data/site";
---

<section id="about" class="scroll-mt-20 border-y border-line bg-surface">
  <div class="mx-auto grid max-w-5xl items-start gap-10 px-6 py-14 sm:px-8 md:grid-cols-[.85fr_1.15fr]">
    <div class="aspect-[4/5] overflow-hidden rounded bg-paper">
      <img
        src={site.about.photo}
        alt={site.about.photoAlt}
        class="h-full w-full object-cover"
        loading="lazy"
        decoding="async"
      />
    </div>

    <div>
      <h2 class="eyebrow mb-5">{site.about.heading}</h2>
      <div class="max-w-prose space-y-4">
        {site.about.paragraphs.map((p) => (
          <p class="text-[14.5px] leading-relaxed text-muted">{p}</p>
        ))}
      </div>
    </div>
  </div>
</section>

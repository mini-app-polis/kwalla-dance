---
import { site } from "../data/site";
import Koala from "./Koala.astro";
---

<!--
  The sage band. Sage is dominant here by AREA rather than by being the page
  background — that is the difference between this reading as editorial and
  reading as a wellness template. Do not lighten it; #5A6A51 is the point at
  which cream body text still clears AA.
-->
<section id="lessons" class="band relative scroll-mt-20">
  <div class="mx-auto max-w-5xl">
    <Koala spot="band" class="bottom-2 left-6 h-8 w-8 text-sage-ink" />

    <p class="mb-1.5 text-eyebrow font-semibold uppercase text-sage-muted">
      What you can book
    </p>
    <p class="mb-6 max-w-[46ch] text-[13.5px] leading-relaxed text-sage-muted">
      Every lesson is booked through Calendly — pick a session, pick a time,
      and it lands on both our calendars.
    </p>

    <div class="grid gap-4 sm:grid-cols-3">
      {site.sessions.map((s) => (
        <div class="rounded border border-line bg-card p-5">
          <h3 class="mb-1.5 font-display text-base font-semibold tracking-tight text-ink">
            {s.name}
          </h3>
          <p class="mb-4 text-[13px] leading-relaxed text-muted">{s.blurb}</p>
          <p class="text-[13px] font-semibold text-clay">
            {s.price ? `${s.price} · ${s.duration}` : s.duration}
          </p>

          <a
            href={site.bookingUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 inline-block text-[13px] font-medium text-ink underline decoration-rule underline-offset-4 transition-colors hover:text-clay"
          >
            Book on Calendly
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

---
import { site } from "../data/site";
---

<!--
  Calendly booking link.

  Direct link to Calendly for booking lessons. No embed complications,
  just a straightforward link to the scheduling page.
-->
<section id="book" class="scroll-mt-20 border-t border-line">
  <div class="mx-auto max-w-5xl px-6 py-14 sm:px-8">
    <p class="eyebrow mb-4">Book</p>
    <h2 class="mb-3 max-w-[20ch] font-display text-3xl font-extrabold tracking-tight text-ink sm:text-4xl">
      Pick a time that's already open
    </h2>
    <p class="mb-8 max-w-prose text-lede text-muted">
      Book directly through Calendly to see my available times. You'll get a confirmation email with all the details.
    </p>

    <div class="rounded border border-line bg-card p-8">
      <p class="mb-5 max-w-prose text-lede text-ink">
        Ready to book? Head over to Calendly to see my available times and pick what works for you.
      </p>
      <a href="https://calendly.com/kwallawcs/" target="_blank" rel="noopener noreferrer" class="btn">
        Open Calendly
      </a>
    </div>
  </div>
</section>

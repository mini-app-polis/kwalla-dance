---
import { site } from "../data/site";

/**
 * Booking is a link out to Calendly, not an embed. The site never manages
 * availability — Calendly owns the calendar, confirmations, and reminders.
 */
---

<section id="book" class="scroll-mt-20 border-t border-line">
  <div class="mx-auto max-w-5xl px-6 py-14 sm:px-8">
    <p class="eyebrow mb-4">Book</p>
    <h2 class="mb-3 max-w-[20ch] font-display text-3xl font-extrabold tracking-tight text-ink sm:text-4xl">
      Pick a time that's already open
    </h2>
    <p class="mb-8 max-w-prose text-lede text-muted">
      Booking runs through Calendly, so there's no back-and-forth to find a
      slot. Pick a time that works and you'll get a confirmation and a
      reminder automatically.
    </p>

    <div class="flex flex-wrap items-center gap-5">
      <a
        href={site.bookingUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn"
      >
        Book on Calendly
      </a>
      <a href={`mailto:${site.email}`} class="link-quiet">
        Or email me with questions
      </a>
    </div>
  </div>
</section>

---
/**
 * A hidden koala.
 *
 * The whole point is that it is missable on a first read and findable on a
 * second. Opacity is set by CSS custom property per placement (see
 * global.css) because a single global value either vanishes against paper or
 * shouts against the sage band.
 *
 * The outline is TRACED, not drawn. Several hand-built attempts at a koala
 * failed in the same way — ears in the wrong place, proportions that read as
 * a bear or a mouse — so the silhouette here comes from vectorising the
 * reference illustration Kristen picked: threshold the artwork, fill it,
 * smooth it (gaussian sigma 8 at 6x scale), and trace it with potrace at
 * opttolerance 1.5. That setting is the balance point; less smoothing keeps
 * the JPEG's wobble in the outline, more of it swallows the ears and paws.
 *
 * The eyes and nose come from the same trace, as the reference draws them —
 * the eyes then scaled to 85% about their own centres, which is as small as
 * they go before the footer placement loses them entirely. They are knocked
 * OUT of the body rather than painted on: the whole mark is
 * translucent, so a painted detail would only be a slightly darker smudge,
 * while a hole shows the page through it — the same trick the favicon uses to
 * work at 16px. No mouth: at these sizes it only ever reads as a smudge.
 *
 * Do not hand-edit these curves. To change the shape, re-trace the source
 * artwork and paste the new paths in whole.
 *
 * Everything in the mask's white group is body; everything black is a hole.
 *
 * aria-hidden throughout: this is decoration and announcing "koala" to a
 * screen reader in the middle of a booking flow would be noise.
 */
interface Props {
  /** Which tuned opacity to use. */
  spot: "hero" | "band" | "calendar" | "footer";
  /** Tailwind positioning + sizing classes for this instance. */
  class?: string;
}

const { spot, class: className = "" } = Astro.props;

const opacity = {
  hero: "var(--koala-hero)",
  band: "var(--koala-band)",
  calendar: "var(--koala-cal)",
  footer: "var(--koala-foot)",
}[spot];

/** Masks are referenced by id, so each placement needs its own. */
const maskId = `koala-body-${spot}`;
---

<span class:list={["koala", className]} style={`opacity:${opacity}`} aria-hidden="true">
  <svg viewBox="0 0 64 64" class="h-full w-full fill-current">
    <mask id={maskId} maskUnits="userSpaceOnUse" x="0" y="0" width="64" height="64">
      <g fill="#fff">
        <path d="M18.9 62.2C12.7 61.0 7.8 54.0 10.4 49.8C10.7 49.4 10.8 49.0 11.0 48.4C11.3 47.0 11.8 46.5 13.4 45.6C15.1 44.7 15.4 44.3 15.4 42.5C15.5 39.5 16.2 37.3 17.9 34.5C19.2 32.4 19.2 32.5 17.7 30.4C16.5 28.7 15.8 27.1 15.4 25.1C15.1 23.6 14.9 23.5 13.6 23.2C11.8 22.9 10.5 21.8 9.9 20.2C9.6 19.5 9.4 19.2 8.6 18.7C6.3 16.9 5.9 14.0 7.4 10.5C7.9 9.3 8.0 9.1 8.0 7.8C8.1 6.2 8.8 5.1 10.6 3.7C11.1 3.3 11.6 2.9 11.8 2.7C12.0 2.5 12.8 2.3 14.6 1.8C15.3 1.6 15.5 1.6 16.9 1.6L18.4 1.5L19.4 1.9C21.3 2.5 22.4 3.3 23.3 4.6C24.1 6.0 24.5 6.1 26.2 5.5C26.4 5.4 27.1 5.2 27.7 5.1L28.7 4.8L31.9 4.8L35.2 4.8L36.1 5.0C36.6 5.2 37.5 5.4 38.0 5.5C39.6 6.0 39.8 6.0 40.8 4.7C42.6 2.3 44.2 1.5 47.2 1.5L48.9 1.5L49.9 1.9C54.0 3.3 55.9 5.2 56.1 8.4C56.2 9.2 56.2 9.3 56.6 10.3C58.2 14.0 57.8 16.8 55.4 18.7C54.7 19.3 54.7 19.3 54.2 20.3C53.3 22.1 52.4 22.8 50.4 23.2C49.2 23.5 49.0 23.7 48.7 25.0C48.3 26.9 47.7 28.4 46.8 29.8C45.3 31.9 45.3 32.3 46.9 34.9C48.5 37.5 49.0 39.3 49.1 42.1C49.2 44.1 49.3 44.3 50.3 44.7C51.5 45.1 53.0 46.9 53.5 48.3C53.6 48.8 53.9 49.5 54.2 50.0C55.0 51.3 55.1 51.9 54.9 53.1C54.3 56.2 52.0 59.1 48.8 61.1C48.4 61.3 48.1 61.6 47.9 61.7C47.6 62.0 47.4 62.0 45.8 62.2C43.1 62.5 42.0 62.2 40.3 61.0C39.2 60.2 38.7 60.2 36.4 60.6C35.1 60.8 29.8 60.8 28.2 60.6C26.5 60.3 26.2 60.3 25.5 60.8C24.8 61.2 24.7 61.3 24.0 61.4C23.7 61.5 23.1 61.7 22.7 61.9L21.8 62.2L20.6 62.2C19.9 62.2 19.1 62.2 18.9 62.2Z" />
      </g>

      <g fill="#000">
        <!-- nose -->
        <path d="M30.9 26.6C28.8 25.8 28.0 23.7 28.7 21.0C29.9 16.5 33.8 16.2 35.2 20.6C35.6 21.8 35.7 22.8 35.4 24.0L35.2 25.0L34.6 25.5C33.6 26.6 32.1 27.0 30.9 26.6Z" />
        <!-- eyes, scaled to 85% about their own centres -->
        <path d="M22.6 21.6C20.8 20.7 21.1 18.0 22.9 17.5L23.4 17.3L23.9 17.5C25.3 17.9 25.8 19.8 24.8 21.0C24.3 21.7 23.3 22.0 22.6 21.6Z" />
        <path d="M40.2 21.8C37.9 21.2 38.4 17.3 40.8 17.4C43.3 17.6 43.3 21.4 40.7 21.8C40.6 21.8 40.4 21.8 40.2 21.8Z" />
      </g>
    </mask>

    <rect width="64" height="64" mask={`url(#${maskId})`} />
  </svg>
</span>

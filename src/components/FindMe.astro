---

<!--
  The sage band. Sage is dominant here by AREA rather than by being the page
  background — that is the difference between this reading as editorial and
  reading as a wellness template. Do not lighten it; #5A6A51 is the point at
  which cream body text still clears AA.
-->
<section id="find" class="band relative scroll-mt-20">
  <div class="mx-auto max-w-5xl">
    <Koala spot="band" class="bottom-2 left-6 h-8 w-8 text-sage-ink" />

    <h2 class="mb-1.5 text-eyebrow font-semibold uppercase text-sage-muted">
      Where to find me
    </h2>
    <p class="mb-6 max-w-[46ch] text-[13.5px] leading-relaxed text-sage-muted">
      Between lessons and events, this is where everything gets posted —
      clips, schedules, and whatever happened last weekend.
    </p>

    <div class="grid gap-4 sm:grid-cols-3">
      {site.findMe.map((f) => (
        <a
          href={f.href}
          target="_blank"
          rel="me noopener noreferrer"
          class="group flex flex-col rounded-sm border border-line bg-card p-5 no-underline transition-colors hover:border-clay"
        >
          <svg
            viewBox="0 0 24 24"
            aria-hidden="true"
            class="mb-3 h-5 w-5 fill-clay"
          >
            <path d={icons[f.id]} />
          </svg>

          <h3 class="font-display text-base font-semibold tracking-tight text-ink">
            {f.name}
          </h3>
          <p class="mb-2 text-[12.5px] text-muted">{f.handle}</p>
          <p class="mb-4 text-[13px] leading-relaxed text-muted">{f.blurb}</p>

          <span class="mt-auto text-[13px] font-medium text-ink underline decoration-rule underline-offset-4 transition-colors group-hover:text-clay">
            {f.cta}
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
